local tw
local function Fly(pos)
    local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not h then return end
    local d = (h.Position - pos).Magnitude
    if d < 30 then h.CFrame = CFrame.new(pos) return end
    if tw then tw:Cancel() end
    tw = TS:Create(h, TweenInfo.new(d/300, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)}) tw:Play()
end

local function Equip(w)
    local c = LP.Character if not c then return end
    if getgenv().Cfg.Haki and not c:FindFirstChild("HasBuso") then pcall(function() CF:InvokeServer("Buso") end) end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and (t.Name == w or t.ToolTip == w or t.Name == "Combat") then t:Activate() return end
    end
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") and (t.Name == w or t.ToolTip == w or t.Name == "Combat") then c.Humanoid:EquipTool(t) break end
    end
end

local function Hit(mon, mH, mHum)
    local lock = mH.Position
    if getgenv().Cfg.Bring then
        for _, e in ipairs(workspace.Enemies:GetChildren()) do
            local h, u = e:FindFirstChild("HumanoidRootPart"), e:FindFirstChild("Humanoid")
            if e.Name == mon and h and u and u.Health > 0 and (h.Position - lock).Magnitude <= 260 then
                h.CFrame, h.Velocity, h.CanCollide, u.WalkSpeed = CFrame.new(lock), Vector3.zero, false, 0
            end
        end
    end
    if getgenv().Cfg.Mastery and mHum and (mHum.Health / mHum.MaxHealth) <= 0.35 then
        for _, t in ipairs(LP.Backpack:GetChildren()) do
            if t:IsA("Tool") and (t.ToolTip == "Blox Fruit" or t.ToolTip == "Gun") then LP.Character.Humanoid:EquipTool(t) end
        end
        for _, k in ipairs({"Z","X","C","V"}) do
            VIM:SendKeyEvent(true, k, false, game) task.wait(0.04) VIM:SendKeyEvent(false, k, false, game)
        end
    else
        Equip(getgenv().Cfg.Weapon)
        VU:CaptureController() VU:Button1Down(Vector2.new(500,500))
        pcall(function() Rep.Modules.Net["RE/RegisterAttack"]:FireServer(0) Rep.Modules.Net["RE/RegisterHit"]:FireServer(mH,{}) end)
    end
end

